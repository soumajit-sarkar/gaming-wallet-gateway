# Copy this file to .env and set a database that you control.
DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/gaming_wallet_test
APP_NAME=Gaming Wallet Gateway
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# Optional distributed wallet lock. Leave blank to rely on MySQL row locks only.
REDIS_URL=

# Provider-specific API secrets are read from the environment, never stored in the DB.
# PROVIDER_DEMO_API_KEY=replace_me

# RabbitMQ local defaults. Use dedicated credentials outside local development.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
